------MultipartBoundary--WJCwS94UbR12QAZRzJU2BMtW8iVGwIgHKZyqq2UF8w----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.repstatic.it/cless/common/box/ilmiolibro/assets/css/style.css

@charset "utf-8";

.box-miolibro * { box-sizing: content-box; }

.box-miolibro { width: 100%; border: 1px solid rgb(221, 221, 221); margin: 0px 0px 30px; font-family: arial; zoom: 1; }

.box-miolibro::before, .box-miolibro::after { content: ""; display: table; }

.box-miolibro::after { clear: both; }

.box-miolibro a { text-decoration: none; }

.box-miolibro .miolibro-logo { height: 47px; border-bottom: 1px solid rgb(221, 221, 221); }

.box-miolibro .miolibro-logo .assistive-text { clip: rect(1px, 1px, 1px, 1px); position: absolute !important; }

.box-miolibro .miolibro-logo a { width: 133px; height: 20px; display: block; padding-top: 22px; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/logo-mio-libro.png") center center no-repeat; margin: 0px auto; }

.box-miolibro .iml-article-big { width: 100%; height: 176px; position: relative; overflow: hidden; }

.box-miolibro .iml-article-big a { display: block; text-decoration: none; color: rgb(255, 255, 255); }

.box-miolibro .iml-article-big a img { width: 100%; display: block; }

.box-miolibro .iml-article-big .iml-article-content { width: 100%; position: absolute; z-index: 2; bottom: -4px; padding: 50px 0px 15px 20px; text-overflow: ellipsis; background: linear-gradient(rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.9) 100%); }

.box-miolibro .iml-article-big .iml-article-content .iml-label { margin-bottom: 7px; background-color: rgb(237, 61, 61); color: rgb(255, 255, 255); font-size: 11px; padding: 4px 6px; text-transform: uppercase; }

.box-miolibro .iml-article-big .iml-article-content h2 { margin: 8px 10px 0px 0px; padding-right: 11px; font-size: 18px; line-height: 19px; }

.box-miolibro .iml-article-little { padding: 20px 17px; zoom: 1; }

.box-miolibro .iml-article-little::before, .box-miolibro .iml-article-little::after { content: ""; display: table; }

.box-miolibro .iml-article-little::after { clear: both; }

.box-miolibro .iml-article-little a img { float: left; margin-right: 15px; margin-bottom: 6px; border: 1px solid rgb(221, 221, 221); width: 70px; }

.box-miolibro .iml-article-little h2 { margin: 0px; }

.box-miolibro .iml-article-little h2 a { font-size: 18px; line-height: 19px; color: rgb(0, 0, 0); font-weight: 500; text-overflow: ellipsis; }

.box-miolibro .iml-article-little .iml-author { display: block; margin-top: 17px; font-size: 13px; }

.box-miolibro .iml-article-little .iml-gender { text-transform: uppercase; color: rgb(237, 61, 61); }

.box-miolibro .iml-article-little.tablet { zoom: 1; padding: 23px 17px 14px; }

.box-miolibro .iml-article-little.tablet::before, .box-miolibro .iml-article-little.tablet::after { content: ""; display: table; }

.box-miolibro .iml-article-little.tablet::after { clear: both; }

.box-miolibro .iml-article-little.tablet .cover-book { width: 105px; height: 152px; display: block; float: left; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/tablet.png") 0px 0px no-repeat; padding: 9px 0px 0px 6px; }

.box-miolibro .iml-article-little.tablet .cover-book img { border: 0px; }

.box-miolibro .iml-article-little.tablet .iml-label { display: inline-block; margin-bottom: 10px; background-color: rgb(237, 61, 61); color: rgb(255, 255, 255); font-size: 11px; padding: 4px 6px; text-transform: uppercase; }

.box-miolibro .iml-article-little.tablet h2 a { display: block; width: auto; font-size: 18px; line-height: 20px; }

.box-miolibro .iml-shop-button { border-top: 1px solid rgb(221, 221, 221); zoom: 1; margin: 0px 15px 5px 18px; }

.box-miolibro .iml-shop-button::before, .box-miolibro .iml-shop-button::after { content: ""; display: table; }

.box-miolibro .iml-shop-button::after { clear: both; }

.box-miolibro .iml-shop-button li { float: left; width: 134px; text-align: center; }

.box-miolibro .iml-shop-button li .assistive-text { clip: rect(1px, 1px, 1px, 1px); position: absolute !important; }

.box-miolibro .iml-shop-button a { display: block; padding-top: 35px; margin: 0px auto; }

.box-miolibro .iml-shop-button a.itunes-button { width: 119px; height: 36px; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/itunes-button.png") center center no-repeat; }

.box-miolibro .iml-shop-button a.amazon-button { width: 108px; height: 36px; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/amazon-button.png") center center no-repeat; }

.box-miolibro .iml-bottom-link { width: 100%; margin: 0px; border-top: 1px solid rgb(221, 221, 221); padding: 10px 0px; display: flex; justify-content: space-around; }

.box-miolibro .iml-bottom-link li { width: 50%; text-align: center; list-style-type: none; }

.box-miolibro .iml-bottom-link li.first { border-right: 1px solid rgb(221, 221, 221); }

.box-miolibro .iml-bottom-link li a { font-size: 12px; color: rgb(51, 56, 60); font-weight: bold; }

@media (min--moz-device-pixel-ratio: 1.3), (-o-min-device-pixel-ratio: 2.6/2), (-webkit-min-device-pixel-ratio: 1.3), (min-device-pixel-ratio: 1.3), (min-resolution: 1.3dppx) {
  .box-miolibro .miolibro-logo a { width: 133px; height: 20px; display: block; padding-top: 22px; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/logo-mio-libro@2x.png") center center / contain no-repeat; margin: 0px auto; }
  .box-miolibro .iml-article-little.tablet .cover-book { width: 105px; height: 152px; display: block; float: left; background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/tablet@2x.png") 0px 0px no-repeat; padding: 9px 0px 0px 6px; }
  .box-miolibro .iml-shop-button li a.itunes-button { background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/itunes-button@2x.png") center center / contain no-repeat; }
  .box-miolibro .iml-shop-button li a.amazon-button { background: url("https://www.repstatic.it/cless/common/box/ilmiolibro/assets/img/amazon-button@2x.png") center center / contain no-repeat; }
}
