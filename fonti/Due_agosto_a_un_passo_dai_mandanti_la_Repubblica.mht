@charset "utf-8";

.widget-sponsor--container * { margin: 0px; padding: 0px; list-style-type: none; text-decoration: none; }

.widget-sponsor--container { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; display: flex; flex-wrap: wrap; padding-bottom: 20px; margin: 0px 0px 16px; position: relative; background: rgb(253, 253, 253); border-top: 1px solid rgb(51, 51, 51); overflow: hidden; }

.widget-sponsor--container::before { content: ""; width: 100%; height: 1px; background-color: rgb(144, 144, 144); position: absolute; top: 2px; left: 0px; z-index: 100; }

.widget-sponsor--container article:last-child { border-top: 1px solid rgb(204, 204, 204); }

.widget-sponsor__header { display: flex; width: 100%; }

.widget-sponsor__payoff { padding: 12px 8px; font-size: 12px; line-height: 15px; font-weight: 400; font-style: italic; color: rgb(102, 102, 102); display: inline-flex; width: 100%; text-align: left; justify-content: space-between; align-items: center; }

.widget-sponsor__tooltip { padding: 2px 0px 1px; border: 2px solid rgb(109, 120, 128); border-radius: 50%; margin-left: 0px; background: rgb(255, 255, 255); color: rgb(57, 70, 78); }

.widget-sponsor__tooltip:hover { background: rgb(240, 240, 240); }

.widget-sponsor__tooltip label { position: relative; text-align: center; font-size: 13px; text-decoration: none; font-weight: 700; font-style: normal; display: block; width: 19px; height: 15px; }

.widget-sponsor__tooltip label:hover { cursor: pointer; }

.widget-sponsor__tooltip span { visibility: hidden; width: 250px; top: 2.75em; right: -0.25em; background-color: rgb(57, 70, 78); color: rgb(255, 255, 255); text-align: left; border-radius: 6px; padding: 10px; position: absolute; z-index: 9; margin-left: 1em; opacity: 0; transition: opacity 1s; font-weight: normal; font-size: 12px; line-height: 17px; box-shadow: 0px 0px 1px; }

.widget-sponsor__tooltip span::after { content: ""; position: absolute; top: -0.5em; right: 3%; margin-top: -8px; border-width: 7px; border-style: solid; border-color: transparent transparent rgb(57, 70, 78); }

.widget-sponsor__tooltip input { display: none; }

.widget-sponsor__tooltip input:checked + span { visibility: visible; opacity: 1; }

.widget-sponsor__logo { display: block; padding: 8px; text-align: right; }

.widget-sponsor__logo img { width: 105px; max-width: fit-content; }

.widget-sponsor__label { display: block; width: 100%; position: relative; font-size: 13px; line-height: 13px; font-weight: 500; color: rgb(69, 69, 69); padding: 16px 0px 12px 16px; text-transform: uppercase; }

.widget-sponsor--container a { color: rgb(26, 26, 26); }

.widget-sponsor__main-item { -webkit-box-flex: 1; flex: 1 1 auto; margin-bottom: 8px; padding: 16px; }

.widget-sponsor__main-figure { position: relative; overflow: hidden; margin-bottom: 8px; }

.widget-sponsor__main-figure img { width: 100%; display: block; }

.widget-sponsor__main-content { padding: 0px; margin-bottom: 24px; margin-top: 4px; }

.widget-sponsor__main-overtitle, .widget-sponsor__main-overtitle a { font-size: 13px; line-height: 24px; font-weight: 400; color: rgb(73, 82, 84); text-transform: uppercase; }

.widget-sponsor__main-title { font-size: 18px; line-height: 20px; margin-bottom: 6px; font-weight: 700; }

.widget-sponsor__main-author { font-size: 13px; font-style: italic; display: block; color: rgb(0, 0, 0); margin-bottom: 6px; }

.widget-sponsor__main-content p { font-size: 14px; line-height: 17px; margin-bottom: 4px; }

.widget-sponsor__main-content p b { text-transform: uppercase; }

.widget-sponsor__main-content p a { color: rgb(68, 68, 68); text-decoration: underline; }

.widget-sponsor__sub-title a { color: rgb(96, 96, 96); font-weight: 400; }

.widget-sponsor__sub-item { display: flex; margin: 16px 0px; border-top: 1px solid rgb(230, 230, 230); padding-top: 12px; }

.widget-sponsor__sub-item figure { padding-right: 12px; }

.widget-sponsor__sub-item figure img { width: 80px; }

