@charset "utf-8";

.toast, .warning { white-space: normal; text-indent: initial; }

.toast, .warning__content { font-family: "Eugenio Sans Text", "Helvetica Neue", Helvetica, sans-serif; }

.toast__button, .warning__button { text-align: center; align-self: center; }

.toast { z-index: 1000; background: var(--toast-background,#333); padding: 16px 24px; border-radius: 4px; color: var(--toast-text-color,#fff); font-size: 14px; line-height: 20px; text-align: center; opacity: 0; }

.toast__close, .warning__close { right: 0px; height: 36px; cursor: pointer; }

.toast.toast--web { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; gap: 16px; padding: 32px 16px 16px; }

.toast__close { position: absolute; top: 0px; width: 36px; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.toast__close::after, .toast__close::before { content: ""; position: absolute; top: 50%; left: 50%; width: 20px; height: 2px; transform-origin: center center; background-color: var(--toast-text-color,#fff); }

.toast__close::before { transform: translate(-50%, -50%) rotate(45deg); }

.toast__close::after { transform: translate(-50%, -50%) rotate(-45deg); }

.toast__button { background: var(--toast-link-color,#537daa); color: rgb(255, 255, 255); border-radius: 4px; width: 100%; padding-block: 16px; text-transform: none !important; }

.toast__link { color: var(--toast-link-color,#537daa); text-decoration: underline; font-size: 13px; }

:root { --warning-background: #fff; --warning-text-color: #414141; --warning-backdrop: rgba(0, 0, 0, 0.7); }

.warning { display: none; text-transform: none; }

.warning.is-active { display: flex; animation: 0.5s ease-out 0s 1 normal forwards running warning-slide-up; }

@-webkit-keyframes warning-slide-up { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes warning-slide-up { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.warning button:focus { outline: 0px; }

.warning button:hover { cursor: pointer; }

.warning__content { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; gap: 16px; position: relative; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background-color: var(--warning-background); border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.5) 0px 2px 4px 0px; color: var(--warning-text-color,#414141); padding: 32px 16px 16px; pointer-events: initial !important; }

.warning__close { position: absolute; top: 0px; width: 36px; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.warning__close::after, .warning__close::before { content: ""; position: absolute; top: 50%; left: 50%; width: 20px; height: 2px; transform-origin: center center; background-color: var(--warning-text-color); }

.warning__close::before { transform: translate(-50%, -50%) rotate(45deg); }

.warning__close::after { transform: translate(-50%, -50%) rotate(-45deg); }

.warning__text { font-size: 16px; line-height: 22px; }

.warning__button { background: var(--warning-link-color,#537daa); color: rgb(255, 255, 255); border-radius: 4px; width: 100%; padding-block: 16px; text-transform: none !important; }

.warning__link { color: var(--warning-link-color,#537daa); text-decoration: underline; font-size: 13px; }

.trial-state { position: fixed; bottom: env(safe-area-inset-bottom,0); left: env(safe-area-inset-left,0); right: env(safe-area-inset-right,0); display: flex; -webkit-box-pack: end; justify-content: flex-end; -webkit-box-align: center; align-items: center; gap: 16px; padding: 10px 16px; font: 400 14px / 18px "Eugenio Sans Text", "Helvetica Neue", Helvetica, sans-serif; color: rgb(255, 255, 255); background: linear-gradient(357.16deg, rgb(67, 115, 167) -17.21%, rgb(49, 91, 136) 97.64%); }

.trial-state.is-active { display: block; }

.trial-state__text { margin-right: auto; }

.trial-state__button { background-color: rgb(255, 255, 255); color: rgb(83, 125, 170); border-radius: 16px; font-size: 11px; padding: 3px 10px; }

.trial-state__close { position: relative; width: 36px; height: 36px; cursor: pointer; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.trial-state__close::after, .trial-state__close::before { content: ""; position: absolute; top: 50%; left: 50%; width: 20px; height: 2px; transform-origin: center center; background-color: rgb(255, 255, 255); }

.trial-state__close::before { transform: translate(-50%, -50%) rotate(45deg); }

.trial-state__close::after { transform: translate(-50%, -50%) rotate(-45deg); }

@media screen and (max-width: 1023px) {
  .toast { position: fixed; bottom: calc(env(safe-area-inset-bottom) + 20px); left: 16px; right: 16px; }
