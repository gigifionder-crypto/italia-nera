.subscription-button { width: 165px; height: 30px; perspective: 800px; }

.subscription-card { display: block; width: 100%; height: 100%; position: relative; transform-style: preserve-3d; animation: 10s ease-in-out 0s infinite normal none running flipLoop; }

.subscription-face { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; display: flex; -webkit-box-align: center; align-items: center; border-radius: 4px; cursor: pointer; text-transform: uppercase; font-size: 12px; letter-spacing: 0.32px; transition: filter 0.15s, -webkit-filter 0.15s; }

.subscription-face--back { transform: rotateX(180deg); color: rgb(255, 255, 255); background: rgb(49, 91, 136); }

.subscription-face--back:hover { background-color: rgb(0, 0, 0); }

@media screen and (min-width: 768px) {
  .subscription-face { -webkit-box-pack: center; justify-content: center; }
}

@media screen and (max-width: 767px) {
  .subscription-face--front { justify-content: right; }
  .subscription-face--back { -webkit-box-pack: center; justify-content: center; }
}

@-webkit-keyframes flipLoop { 
  40% { transform: rotateX(0deg); }
  50% { transform: rotateX(180deg); }
  80% { transform: rotateX(180deg); }
  90% { transform: rotateX(0deg); }
}

@keyframes flipLoop { 
  40% { transform: rotateX(0deg); }
  50% { transform: rotateX(180deg); }
  80% { transform: rotateX(180deg); }
  90% { transform: rotateX(0deg); }
}
